              " pm.environment.set(\"name\", \"user\" + randomString);",
              " pm.environment.set(\"email\", \"user\" + randomString+ \"@gmail.com\");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
